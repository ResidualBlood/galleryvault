{
  "name": "galleryvault-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "GalleryVault Vue 3 + Vite + TypeScript frontend (project root: frontend/)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",

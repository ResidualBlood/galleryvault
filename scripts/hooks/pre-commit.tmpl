#!/bin/sh
# 职责：提交前只对暂存文件跑格式化与 lint；单文件级、秒级返回，不做全量测试。
# 本模板只带断链检查这一项，项目按需在下方补格式化 / lint 命令。
# 出处: 本机参考项目 AGENTS.md:80、docs/dev/handbook/13-conventions.md:135-143（通用化，见调研 §R-constraints）
# 设计说明：钩子只给模板与安装说明，不自动安装。
# Pre-commit hook template (not installed automatically).
# Install from the project root:
#   cp scripts/hooks/pre-commit.tmpl .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Remove this hook with: rm .git/hooks/pre-commit
set -eu
root=$(git rev-parse --show-toplevel)
python3 "$root/scripts/check_doc_links.py" --root "$root" --code-comments --json >/dev/null

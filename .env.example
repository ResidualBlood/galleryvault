# GalleryVault needs no .env file.  All user settings are configured in the SPA
# Settings page and persisted to PostgreSQL.  Only infra values that the
# backend needs before the database is reachable can be overridden here.
#
# DATABASE_URL=postgresql+asyncpg://galleryvault:galleryvault@db:5432/galleryvault
# DOWNLOAD_ROOT=/downloads
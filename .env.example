# GalleryVault needs no .env file.  All user settings are configured in the SPA
# Settings page and persisted to PostgreSQL.  Only infra values that the
# backend needs before the database is reachable can be overridden here.
#
# PostgreSQL password for the `db` service. The compose file defaults to
# `galleryvault`; for anything beyond localhost, set a strong one:
#   POSTGRES_PASSWORD=change-me-to-a-long-random-string
#
# DATABASE_URL=postgresql+asyncpg://galleryvault:galleryvault@db:5432/galleryvault
# DOWNLOAD_ROOT=/downloads
#
# Database pool sizing and connection-level timeouts (0 disables a timeout cap):
# DATABASE_POOL_SIZE=30
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT=30
# WORKER_DATABASE_POOL_SIZE=5
# WORKER_DATABASE_MAX_OVERFLOW=5
# WORKER_DATABASE_POOL_TIMEOUT=30
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_LOCK_TIMEOUT_MS=5000
# DATABASE_IDLE_IN_TX_TIMEOUT_MS=60000
# WORKER_DATABASE_STATEMENT_TIMEOUT_MS=0
# WORKER_DATABASE_LOCK_TIMEOUT_MS=10000
# WORKER_DATABASE_IDLE_IN_TX_TIMEOUT_MS=300000
#
# Alembic advisory-lock wait cap in seconds (default 120):
# GALLERYVAULT_MIGRATION_LOCK_TIMEOUT=120

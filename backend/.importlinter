[importlinter]
root_package = galleryvault

[importlinter:contract:1]
name = Services, db and scanners must not import the app assembly
type = forbidden
source_modules =
    galleryvault.services
    galleryvault.db
    galleryvault.scanners
    galleryvault.metadata
forbidden_modules =
    galleryvault.app.routers
    galleryvault.app.lifespan
    galleryvault.app.main

[importlinter:contract:2]
name = The database layer must not import services
type = forbidden
# Direct imports only: db -> config -> services is a config layering concern,
# not a db -> services dependency.
allow_indirect_imports = true
source_modules =
    galleryvault.db
forbidden_modules =
    galleryvault.services

# ---------------------------------------------------------------------------
# Contract slots for the B9-B11 service splits (T9.0a).
# Slots are inert ordering anchors: they register no contract by themselves.
# Future batches append their contract section below the matching slot.
#
# slot: download
#   Download service split lands its contract below this marker.
#   Keep the marker line unchanged; batched writers depend on it as an anchor.
#   The slot adds no constraint until a contract section follows it.

[importlinter:contract:download-no-facade-backref]
name = download package must not import its legacy facade
type = forbidden
allow_indirect_imports = true
source_modules =
    galleryvault.services.download
forbidden_modules =
    galleryvault.services.download_worker

# slot: library
#   Library service split lands its contract below this marker.
#   Keep the marker line unchanged; batched writers depend on it as an anchor.
#   The slot adds no constraint until a contract section follows it.

[importlinter:contract:library-usecases-injected]
name = library listing/deletion use-cases take collaborators by injection
type = forbidden
allow_indirect_imports = true
source_modules =
    galleryvault.services.library.listing
    galleryvault.services.library.deletion
forbidden_modules =
    galleryvault.app.state
    galleryvault.app.dependencies

# slot: reading
#   Reading service split lands its contract below this marker.
#   Keep the marker line unchanged; batched writers depend on it as an anchor.
#   The slot adds no constraint until a contract section follows it.

[importlinter:contract:reading-usecases-injected]
name = reading use-cases take collaborators by injection
type = forbidden
allow_indirect_imports = true
source_modules =
    galleryvault.services.reading
forbidden_modules =
    galleryvault.app.state
    galleryvault.app.dependencies

# slot: favorites
#   Favorites service split lands its contract below this marker.
#   Keep the marker line unchanged; batched writers depend on it as an anchor.
#   The slot adds no constraint until a contract section follows it.
# slot: eh
#   EH client split lands its contract below this marker.
#   Keep the marker line unchanged; batched writers depend on it as an anchor.
#   The slot adds no constraint until a contract section follows it.

[importlinter:contract:eh-parsers-pure]
name = eh parsers are pure
type = forbidden
source_modules =
    galleryvault.services.eh.parsers
forbidden_modules =
    galleryvault.services.eh_client
    galleryvault.app
    galleryvault.db

[importlinter:contract:eh-single-session]
name = eh feature modules must not import the legacy client facade
type = forbidden
allow_indirect_imports = true
source_modules =
    galleryvault.services.eh.session
    galleryvault.services.eh.gallery
    galleryvault.services.eh.search
    galleryvault.services.eh.favorites
    galleryvault.services.eh.archive
    galleryvault.services.eh.images
forbidden_modules =
    galleryvault.services.eh_client
# slot: cold
#   Cold archive split lands its contract below this marker.
#   Keep the marker line unchanged; batched writers depend on it as an anchor.
#   The slot adds no constraint until a contract section follows it.
# slot: maintain
#   Maintenance service split lands its contract below this marker.
#   Keep the marker line unchanged; batched writers depend on it as an anchor.
#   The slot adds no constraint until a contract section follows it.
# slot: edge
#   Edge/telegram split lands its contract below this marker.
#   Keep the marker line unchanged; batched writers depend on it as an anchor.
#   The slot adds no constraint until a contract section follows it.

[importlinter:contract:favorites-no-facade-backref]
name = favorites cover_cache/poll/counts must not import the legacy worker facade
type = forbidden
allow_indirect_imports = true
source_modules =
    galleryvault.services.favorites.cover_cache
    galleryvault.services.favorites.poll
    galleryvault.services.favorites.counts
forbidden_modules =
    galleryvault.services.favorites_worker

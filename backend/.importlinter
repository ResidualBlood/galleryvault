[importlinter]
root_package = galleryvault

[importlinter:contract:1]
name = Services, db and scanners must not import the app assembly
type = forbidden
source_modules =
    galleryvault.services
    galleryvault.db
    galleryvault.scanners
    galleryvault.metadata
forbidden_modules =
    galleryvault.app.routers
    galleryvault.app.lifespan
    galleryvault.app.main

[importlinter:contract:2]
name = The database layer must not import services
type = forbidden
# Direct imports only: db -> config -> services is a config layering concern,
# not a db -> services dependency.
allow_indirect_imports = true
source_modules =
    galleryvault.db
forbidden_modules =
    galleryvault.services

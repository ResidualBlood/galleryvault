# GalleryVault no longer requires a .env file.
#
# Fresh install: `docker compose up -d` works out of the box.  The app connects
# to PostgreSQL using DATABASE_URL (below), runs migrations, then on first boot
# it generates and persists an auth_secret in the DB.  Every setting that is
# exposed in the Settings UI (library roots, downloads, proxies, favorites,
# telegram, tag-sync, translation interval, auth_required) is read and written
# directly to PostgreSQL (app_config.user_settings); auth_secret and the
# password hash live in app_config.runtime_auth.  There is no config.json.
#
# Only values needed to reach the database before it can be queried come from
# the environment, and each has a sensible default.

DATABASE_URL=postgresql+asyncpg://galleryvault:galleryvault@db:5432/galleryvault

# Optional infrastructure overrides (all have defaults):
# LOG_LEVEL=INFO
# LOG_JSON=false
# SCAN_BATCH_SIZE=500

# Optional bootstrap values.  If omitted the built-in default password
# ("p1a2s3s4") is used once and the SPA prompts you to change it in Settings.
# AUTH_PASSWORD_HASH=replace-with-pbkdf2-hash   # generate: python -m galleryvault.auth hash-password
# AUTH_SECRET=replace-with-a-random-secret
